# Required provider credentials
GROQ_API_KEY=your_groq_key_here
TAVILY_API_KEY=your_tavily_key_here

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orbit-research-engine
LANGSMITH_TRACING_V2=false

# Optional PostgreSQL (otherwise SQLite is used)
# DATABASE_URL=postgresql://user:password@localhost:5432/orbit

# Optional Celery broker (only needed when running the Celery worker manually)
# REDIS_URL=redis://localhost:6379/0

# Docker Compose local PostgreSQL password (change before any shared deployment)
POSTGRES_PASSWORD=localdevpassword
