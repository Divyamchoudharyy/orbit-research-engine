# Required provider credentials
GROQ_API_KEY=your_groq_key_here
TAVILY_API_KEY=your_tavily_key_here

# Required for production; use a long random value (32+ bytes).
# Local Docker Compose has a development-only fallback if this is blank.
ORBIT_API_KEY=replace_with_a_long_random_secret
ORBIT_UI_PASSWORD=
ORBIT_ENV=development

# Optional tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orbit-research-engine
LANGSMITH_TRACING_V2=false

# PostgreSQL is configured by Docker Compose locally or Render in deployment.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8501

# Docker Compose PostgreSQL password. Change for any shared environment.
POSTGRES_PASSWORD=localdevpassword

# Optional custom persistent data directory when using SQLite.
# ORBIT_DATA_DIR=/var/data
